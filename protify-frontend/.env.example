# Copy to .env.local (git-ignored). Both values are public by design — neither is a secret.

# Where the API lives. Left empty in dev so requests go to /api/v1 on the Vite dev server,
# which proxies to localhost:8080 (see vite.config.ts) and avoids CORS entirely.
VITE_API_BASE_URL=

# The same GOOGLE_CLIENT_ID the backend validates the token's `aud` against. Without it the
# sign-in screen falls back to pasting a token by hand, which is enough to demo the API.
VITE_GOOGLE_CLIENT_ID=
